# ============================================================================
# EclipseLink AI™ - Production Environment Variables
# ============================================================================
# This file contains production-ready environment variable templates
# COPY THIS FILE: cp .env.production.example .env.production
# THEN: Fill in all values marked with [REQUIRED]
# ============================================================================

# ====================
# GENERAL
# ====================
ENVIRONMENT=production
DEBUG=false

# ====================
# DATABASE (PostgreSQL)
# ====================
# [REQUIRED] Production database connection string
# For Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# For Railway: Use Railway-provided DATABASE_URL
# For AWS RDS: postgresql://[username]:[password]@[endpoint]:5432/[dbname]
DATABASE_URL=[REQUIRED]

# Supabase (if using Supabase for database + auth + storage)
SUPABASE_URL=[REQUIRED-IF-USING-SUPABASE]
SUPABASE_KEY=[REQUIRED-IF-USING-SUPABASE]
SUPABASE_SERVICE_ROLE_KEY=[REQUIRED-IF-USING-SUPABASE]

# ====================
# REDIS (Cache & Sessions)
# ====================
# [REQUIRED] Production Redis connection
# For Upstash: redis://default:[PASSWORD]@[ENDPOINT].upstash.io:6379
# For Railway: Use Railway-provided REDIS_URL
# For AWS ElastiCache: redis://[endpoint]:6379
REDIS_URL=[REQUIRED]
REDIS_PASSWORD=[REQUIRED]

# ====================
# SECURITY (JWT)
# ====================
# [REQUIRED] Generate with: openssl rand -hex 32
# NEVER use development secrets in production!
SECRET_KEY=[REQUIRED-GENERATE-WITH-OPENSSL]
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ====================
# AI SERVICES
# ====================
# [REQUIRED] OpenAI API for Whisper transcription
# Get from: https://platform.openai.com/api-keys
# Budget: ~$0.006/minute of audio (~$20/month for 100 handoffs/day)
OPENAI_API_KEY=[REQUIRED]
OPENAI_WHISPER_MODEL=whisper-1

# [REQUIRED] Anthropic API for Claude SBAR generation
# Get from: https://console.anthropic.com/settings/keys
# Budget: ~$0.50/handoff (~$50/month for 100 handoffs/day)
ANTHROPIC_API_KEY=[REQUIRED]
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096

# ====================
# CORS (Frontend URLs)
# ====================
# [REQUIRED] Add your production frontend URLs
# Examples: ["https://app.yourdomain.com","https://www.yourdomain.com"]
CORS_ORIGINS='["https://your-frontend.vercel.app"]'

# Frontend environment variables (for Vercel/Cloudflare Pages)
VITE_API_URL=https://your-backend.railway.app/api
VITE_ENVIRONMENT=production

# ====================
# EMAIL (SMTP - Optional but recommended)
# ====================
# For notifications and password resets
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=[YOUR-SENDGRID-USERNAME]
SMTP_PASSWORD=[YOUR-SENDGRID-PASSWORD]
SMTP_FROM=noreply@yourdomain.com

# ====================
# FILE STORAGE (Production)
# ====================
# Use Supabase Storage or Cloudflare R2
# For Cloudflare R2:
# R2_ACCOUNT_ID=[YOUR-CLOUDFLARE-ACCOUNT-ID]
# R2_ACCESS_KEY_ID=[YOUR-R2-ACCESS-KEY]
# R2_SECRET_ACCESS_KEY=[YOUR-R2-SECRET-KEY]
# R2_BUCKET_NAME=eclipselink-audio
# R2_PUBLIC_URL=https://[YOUR-BUCKET].r2.cloudflarestorage.com

# ====================
# MONITORING & LOGGING
# ====================
# [OPTIONAL] Sentry for error tracking
SENTRY_DSN=[OPTIONAL-BUT-RECOMMENDED]
LOG_LEVEL=INFO

# [OPTIONAL] LogDNA/Datadog for log aggregation
# LOGDNA_KEY=[YOUR-LOGDNA-KEY]

# ====================
# SECURITY & COMPLIANCE
# ====================
# Rate limiting (protect against abuse)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Session security
SESSION_TIMEOUT_MINUTES=15
SESSION_SECURE_COOKIE=true

# HIPAA Compliance
AUDIT_LOG_RETENTION_DAYS=2555
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGITS=true
PASSWORD_REQUIRE_SPECIAL=true

# ====================
# FEATURE FLAGS
# ====================
# Enable/disable features in production
ENABLE_REWARDS_SYSTEM=true
ENABLE_FAMILY_PORTAL=false
ENABLE_AI_CHATBOT=false
ENABLE_MULTILINGUAL=false
ENABLE_EHR_INTEGRATION=false

# ====================
# PERFORMANCE
# ====================
# Worker/process configuration
WORKERS=2
MAX_CONNECTIONS=100
CONNECTION_POOL_SIZE=20

# ====================
# BACKUP & DISASTER RECOVERY
# ====================
# Backup configuration (if self-hosted)
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
# BACKUP_RETENTION_DAYS=30
# BACKUP_S3_BUCKET=[YOUR-BACKUP-BUCKET]

# ============================================================================
# DEPLOYMENT CHECKLIST
# ============================================================================
# Before going to production, ensure:
#
# ✅ All [REQUIRED] fields are filled
# ✅ SECRET_KEY is generated with: openssl rand -hex 32
# ✅ Database backups are configured
# ✅ SSL/TLS certificates are valid
# ✅ CORS_ORIGINS includes only your domains
# ✅ DEBUG=false
# ✅ Strong passwords for all services
# ✅ Sentry or error monitoring is configured
# ✅ Health check endpoints are accessible
# ✅ Load testing completed
# ✅ Security scan completed
# ✅ HIPAA compliance review completed
# ✅ Incident response plan documented
#
# ============================================================================
# BUDGET ESTIMATE (Production - 100 users)
# ============================================================================
# Database (Supabase Pro):        $25/month
# Backend (Railway):              $20/month
# Frontend (Vercel Pro):          $20/month (or free with hobby)
# Redis (Upstash):                $10/month
# OpenAI API:                     $20/month
# Anthropic API:                  $50/month
# Email (SendGrid):               $15/month
# Monitoring (Sentry):            $26/month (or free tier)
# Domain + SSL:                   $12/year
# ----------------------------------------
# TOTAL:                          ~$160-186/month
# Per-user cost:                  ~$1.60-1.86/user/month
# Pricing to customer:            $29/user/month
# Gross margin:                   ~94%
# ============================================================================
