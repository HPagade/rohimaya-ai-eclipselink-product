{
  "name": "eclipselink-ai",
  "version": "1.0.0",
  "description": "EclipseLink AI™ - Voice-enabled clinical handoff platform with AI-powered SBAR generation",
  "private": true,
  "workspaces": [
    "apps/frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "dev:backend": "cd apps/backend && uvicorn app.main:app --reload --port 4000",
    "build": "npm run build --workspace=apps/frontend",
    "build:frontend": "npm run build --workspace=apps/frontend",
    "test": "npm run test --workspace=apps/frontend",
    "test:frontend": "npm run test --workspace=apps/frontend",
    "lint": "npm run lint --workspace=apps/frontend",
    "lint:fix": "npm run lint:fix --workspace=apps/frontend",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "clean": "rm -rf node_modules apps/frontend/node_modules"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HPagade/rohimaya-ai-eclipselink-product.git"
  },
  "keywords": [
    "healthcare",
    "clinical-handoff",
    "SBAR",
    "AI",
    "voice-to-text",
    "HIPAA",
    "EHR",
    "Azure-OpenAI"
  ],
  "author": "Rohimaya Health AI",
  "license": "PROPRIETARY"
}
