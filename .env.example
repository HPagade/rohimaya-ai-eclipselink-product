# ============================================================================
# EclipseLink AI™ - Environment Variables
# Python FastAPI + React + Vite Stack
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
#
# To use: cp .env.example .env
# Then edit .env with your actual credentials
# ============================================================================

# ====================
# GENERAL
# ====================
ENVIRONMENT=development
DEBUG=true

# ====================
# DATABASE (PostgreSQL)
# ====================
# Local development (Docker)
POSTGRES_PASSWORD=changeme_dev_only
DATABASE_URL=postgresql://eclipselink_user:changeme_dev_only@localhost:5432/eclipselink

# Production (Supabase) - uncomment when deploying
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres
# SUPABASE_URL=https://[YOUR-PROJECT].supabase.co
# SUPABASE_KEY=your-supabase-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ====================
# REDIS (Cache & Sessions)
# ====================
# Local development (Docker)
REDIS_PASSWORD=changeme_dev_only

# Production (Upstash) - uncomment when deploying
# REDIS_URL=redis://default:[YOUR-PASSWORD]@[YOUR-ENDPOINT].upstash.io:6379

# ====================
# SECURITY (JWT)
# ====================
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ====================
# AI SERVICES
# ====================

# OpenAI (Whisper for voice transcription)
# Get from: https://platform.openai.com/api-keys
# Cost: ~$0.006/minute of audio
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic (Claude Sonnet 4 for SBAR generation)
# Get from: https://console.anthropic.com/settings/keys
# Cost: $3 per million input tokens, $15 per million output tokens
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096

# ====================
# CORS (Frontend URLs)
# ====================
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173"]'
VITE_API_URL=http://localhost:4000/api
VITE_ENVIRONMENT=development

# ====================
# EMAIL (SMTP - Optional)
# ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@eclipselink.ai

# ====================
# FILE STORAGE (Optional - for production)
# ====================
# Supabase Storage (recommended) or Cloudflare R2
# For now, files will be stored locally in development

# ====================
# MONITORING (Optional)
# ====================
SENTRY_DSN=
LOG_LEVEL=INFO

# ============================================================================
# QUICK START GUIDE
# ============================================================================
#
# 1. COPY THIS FILE:
#    cp .env.example .env
#
# 2. GET YOUR API KEYS (Required for MVP):
#    - OpenAI: https://platform.openai.com/api-keys (~$10/month for testing)
#    - Anthropic: https://console.anthropic.com/settings/keys (~$20/month)
#
# 3. OPTIONAL SERVICES (for production):
#    - Supabase: https://supabase.com (Free tier available)
#    - Railway: https://railway.app (For deployment, ~$5-10/month)
#
# 4. START DEVELOPMENT:
#    docker-compose up
#
#    OR manually:
#    cd apps/backend && pip install -r requirements.txt && uvicorn app.main:app --reload
#    cd apps/frontend && npm install && npm run dev
#
# 5. ACCESS THE APP:
#    Frontend: http://localhost:3000
#    Backend API: http://localhost:4000
#    API Docs: http://localhost:4000/api/docs
#
# ============================================================================
# BUDGET BREAKDOWN (~$100/month total)
# ============================================================================
# OpenAI Whisper:    ~$20/month (voice transcription)
# Anthropic Claude:  ~$30/month (SBAR generation)
# Railway:           ~$10/month (hosting)
# Supabase:          Free tier (database + auth + storage)
# Domain:            ~$12/year (optional)
# ============================================================================

# ============================================================================
# SECURITY NOTES
# ============================================================================
# 1. NEVER commit .env file to Git
# 2. Generate strong secrets with: openssl rand -hex 32
# 3. Rotate credentials every 90 days
# 4. Use different credentials for dev/staging/production
# 5. Enable 2FA on all service accounts
# ============================================================================
