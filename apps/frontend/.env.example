# ============================================================================
# EclipseLink AI Frontend - Environment Variables
# ============================================================================

# Supabase Configuration
# Get these from: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Edge Functions URL (same as Supabase URL + /functions/v1)
VITE_EDGE_FUNCTION_URL=https://your-project.supabase.co/functions/v1

# App Configuration
VITE_APP_NAME=EclipseLink AI
VITE_APP_URL=http://localhost:5173

# Environment
VITE_ENVIRONMENT=development

# Optional: Analytics & Monitoring
# VITE_POSTHOG_KEY=your-posthog-key
# VITE_SENTRY_DSN=your-sentry-dsn

# Optional: Feature Flags
VITE_ENABLE_FAMILY_PORTAL=true
VITE_ENABLE_QR_ACCESS=true
VITE_ENABLE_OFFLINE_MODE=true

# ============================================================================
# IMPORTANT NOTES:
# ============================================================================
#
# 1. NEVER commit the actual .env file with real keys to git
# 2. For production, set these in Vercel dashboard:
#    - Settings → Environment Variables
# 3. The VITE_ prefix is required for Vite to expose vars to the browser
# 4. ANON_KEY is safe to expose in frontend (public key)
# 5. NEVER use SERVICE_ROLE_KEY in frontend (security risk)
#
# ============================================================================
